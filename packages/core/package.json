{
	"name": "@ilamy/core",
	"version": "4.0.0",
	"private": true,
	"description": "Framework-agnostic headless calendar engine (Temporal date math, layout, business hours, constraints, state controller) for @ilamy/calendar.",
	"author": "Sujeet Kc",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kcsujeet/ilamy-calendar.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "CI=true NODE_ENV=production bunx bunup",
		"type-check": "bunx tsc --noEmit",
		"test": "bun test",
		"lint": "bunx biome lint . --diagnostic-level=error",
		"check": "bunx biome check . --diagnostic-level=error",
		"ci": "bun run check && bun run type-check && bun run build"
	},
	"dependencies": {
		"@ilamy/utils": "workspace:*"
	}
}
