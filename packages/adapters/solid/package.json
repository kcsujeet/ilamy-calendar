		"ci": "bun run check && bun run type-check && bun run test && bun run build"
	},
	"dependencies": {
		"@ilamy/core": "workspace:*",
		"@ilamy/dom": "workspace:*"
	},
	"peerDependencies": {
		"solid-js": "^2.0.0"
	},
	"devDependencies": {
		"solid-js": "2.0.3"
	}
