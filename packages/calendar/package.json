{
	"name": "@ilamy/calendar",
	"version": "4.0.0",
	"description": "A headless-core React calendar component library with Temporal timezones, RFC 5545 recurrence, and Tailwind/shadcn, MUI, and StyleX themes.",
	"author": "Sujeet Kc",
	"license": "MIT",
	"homepage": "https://ilamy.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kcsujeet/ilamy-calendar.git"
	},
	"bugs": {
		"url": "https://github.com/kcsujeet/ilamy-calendar/issues"
	},
	"keywords": [
		"react",
		"calendar",
		"headless",
		"temporal",
		"typescript",
		"tailwind",
		"shadcn",
		"mui",
		"stylex",
		"dnd-kit",
		"events",
		"scheduling",
		"drag-and-drop",
		"recurring-events"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"import": "./dist/core.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./plugins/recurrence": {
			"types": "./dist/plugins/recurrence.d.ts",
			"import": "./dist/plugins/recurrence.js"
		},
		"./plugins/agenda": {
			"types": "./dist/plugins/agenda.d.ts",
			"import": "./dist/plugins/agenda.js"
		},
		"./plugins/drag-to-create": {
			"types": "./dist/plugins/drag-to-create.d.ts",
			"import": "./dist/plugins/drag-to-create.js"
		},
		"./plugins/year": {
			"types": "./dist/plugins/year.d.ts",
			"import": "./dist/plugins/year.js"
		},
		"./plugins/ical": {
			"types": "./dist/plugins/ical.d.ts",
			"import": "./dist/plugins/ical.js"
		},
		"./themes/mui": {
			"types": "./dist/themes/mui.d.ts",
			"import": "./dist/themes/mui.js"
		},
		"./themes/stylex": {
			"types": "./dist/themes/stylex.d.ts",
			"import": "./dist/themes/stylex.js"
		},
		"./vue": {
			"types": "./dist/adapters/vue.d.ts",
			"import": "./dist/adapters/vue.js"
		},
		"./svelte": {
			"types": "./dist/adapters/svelte.d.ts",
			"import": "./dist/adapters/svelte.js"
		},
		"./solid": {
			"types": "./dist/adapters/solid.d.ts",
			"import": "./dist/adapters/solid.js"
		},
		"./angular": {
			"types": "./dist/adapters/angular.d.ts",
			"import": "./dist/adapters/angular.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "CI=true NODE_ENV=production bunx bunup",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"type-check": "bunx tsc --noEmit",
		"check:dist-types": "bunx tsc -p tsconfig.dist.json",
		"lint": "bunx biome lint . --diagnostic-level=error",
		"check": "bunx biome check . --diagnostic-level=error",
		"check:fix": "bunx biome check --write .",
		"ci": "bun run check && bun run type-check && bun run test && bun run build",
		"prepack": "bun scripts/prepack.ts",
		"postpack": "bun scripts/postpack.ts",
		"bench:day-hours": "bun scripts/bench-day-hours.tsx"
	},
	"peerDependencies": {
		"@angular/core": "^22.0.0",
		"@mui/material": "^6.0.0 || ^7.0.0 || ^8.0.0 || ^9.0.0",
		"@stylexjs/stylex": ">=0.10.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"solid-js": "^2.0.0",
		"svelte": "^5.0.0",
		"tailwindcss": "^4.2.2",
		"tailwindcss-animate": "^1.0.7",
		"vue": "^3.5.0"
	},
	"peerDependenciesMeta": {
		"@angular/core": {
			"optional": true
		},
		"@mui/material": {
			"optional": true
		},
		"@stylexjs/stylex": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"tailwindcss": {
			"optional": true
		},
		"tailwindcss-animate": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.18",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-toggle-group": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.475.0",
		"rrule": "^2.8.1",
		"tailwind-merge": "^3.5.0",
		"temporal-polyfill": "1.0.8"
	},
	"devDependencies": {
		"@ilamy/adapter-angular": "workspace:*",
		"@ilamy/adapter-solid": "workspace:*",
		"@ilamy/adapter-svelte": "workspace:*",
		"@ilamy/adapter-vue": "workspace:*",
		"@ilamy/calendar-agenda": "workspace:*",
		"@ilamy/calendar-drag-to-create": "workspace:*",
		"@ilamy/calendar-ical": "workspace:*",
		"@ilamy/calendar-recurrence": "workspace:*",
		"@ilamy/calendar-year": "workspace:*",
		"@ilamy/core": "workspace:*",
		"@ilamy/theme-mui": "workspace:*",
		"@ilamy/theme-stylex": "workspace:*",
		"@ilamy/types": "workspace:*",
		"@ilamy/ui": "workspace:*",
		"@ilamy/utils": "workspace:*"
	},
	"publishConfig": {
		"access": "public"
	}
}
