{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!examples",
			"!dist",
			"!dist-*",
			"!coverage",
			"!out",
			"!**/*.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 80
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noLabelWithoutControl": "warn",
				"noStaticElementInteractions": "warn",
				"useKeyWithClickEvents": "warn",
				"useSemanticElements": "warn",
				"useButtonType": "warn"
			},
			"suspicious": {
				"noArrayIndexKey": "warn",
				"noExplicitAny": "warn",
				"noImplicitAnyLet": "warn",
				"noAssignInExpressions": "warn"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"dayjs": "Please use '@/lib/configs/dayjs-config' instead to ensure timezone consistency."
						}
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "es5",
			"semicolons": "asNeeded"
		}
	},
	"css": {
		"parser": {
			"cssModules": false,
			"allowWrongLineComments": true
		},
		"formatter": {
			"enabled": false
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/calendar/src/components/**",
				"packages/calendar/src/config/**",
				"packages/calendar/src/hooks/**",
				"packages/calendar/src/lib/**",
				"packages/calendar/src/stores/**",
				"packages/calendar/src/types/**",
				"packages/calendar/src/utils/**",
				"packages/playground/src/components/**",
				"packages/playground/src/hooks/**",
				"packages/playground/src/lib/**",
				"packages/playground/src/types/**",
				"packages/playground/src/utils/**",
				"!**/*.test.ts",
				"!**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"dayjs": "Please use '@/lib/configs/dayjs-config' instead to ensure timezone consistency."
								},
								"patterns": [
									{
										"group": [
											"@/features/*",
											"@/features/**",
											"@/app/*",
											"@/app/**",
											"../features/*",
											"../features/**",
											"../../features/*",
											"../../features/**",
											"../app/*",
											"../app/**",
											"../../app/*",
											"../../app/**"
										],
										"message": "Shared code cannot import a feature or app layer (Bulletproof React: shared -> features -> app). Move this file into the feature, or move what it needs into a shared folder."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"packages/calendar/src/features/header/**",
				"!**/*.test.ts",
				"!**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/app/*",
											"@/app/**",
											"@/features/event-form/*",
											"@/features/event-form/**",
											"@/features/drag-and-drop/*",
											"@/features/drag-and-drop/**",
											"@/features/views/*",
											"@/features/views/**"
										],
										"message": "Features cannot import app or sibling features (Bulletproof React: shared -> features -> app)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"packages/calendar/src/features/event-form/**",
				"!**/*.test.ts",
				"!**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/app/*",
											"@/app/**",
											"@/features/header/*",
											"@/features/header/**",
											"@/features/drag-and-drop/*",
											"@/features/drag-and-drop/**",
											"@/features/views/*",
											"@/features/views/**"
										],
										"message": "Features cannot import app or sibling features (Bulletproof React: shared -> features -> app)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"packages/calendar/src/features/drag-and-drop/**",
				"!**/*.test.ts",
				"!**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/app/*",
											"@/app/**",
											"@/features/header/*",
											"@/features/header/**",
											"@/features/event-form/*",
											"@/features/event-form/**",
											"@/features/views/*",
											"@/features/views/**"
										],
										"message": "Features cannot import app or sibling features (Bulletproof React: shared -> features -> app)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"packages/calendar/src/features/views/**",
				"!**/*.test.ts",
				"!**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/app/*",
											"@/app/**",
											"@/features/header/*",
											"@/features/header/**",
											"@/features/event-form/*",
											"@/features/event-form/**",
											"@/features/drag-and-drop/*",
											"@/features/drag-and-drop/**"
										],
										"message": "Features cannot import app or sibling features (Bulletproof React: shared -> features -> app)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/playground/src/features/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["../../../app/*", "../../../app/**"],
										"message": "Features cannot import from the app layer (Bulletproof React: shared -> features -> app)."
									},
									{
										"group": [
											"../../calendar-preview/*",
											"../../calendar-preview/**",
											"../../code-and-log/*",
											"../../code-and-log/**",
											"../../settings/*",
											"../../settings/**"
										],
										"message": "Features cannot import other features directly (Bulletproof React). Compose features in src/app/ or move shared code to src/{components,hooks,lib,types,utils}/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		},
		{
			"includes": ["*.test.ts", "*.test.tsx", "*.spec.ts", "*.spec.tsx"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/src/lib/configs/dayjs-config.ts",
				"packages/utils/src/dayjs.ts",
				"packages/types/src/index.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/demo/**", "packages/playground/**"],
			"linter": {
				"rules": {
					"a11y": {
						"noLabelWithoutControl": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**",
				"!**/*.test.ts",
				"!**/*.test.tsx",
				"!**/*.spec.ts",
				"!**/*.spec.tsx",
				"!apps/**",
				"!packages/playground/**"
			],
			"plugins": ["./biome-plugins/no-inline-template-keys.grit"]
		}
	]
}
