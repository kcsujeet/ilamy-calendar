{
	"name": "@ilamy/utils",
	"version": "4.0.0",
	"private": true,
	"description": "Shared runtime utilities (Temporal date core + pure helpers) for the @ilamy/calendar ecosystem.",
	"author": "Sujeet Kc",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kcsujeet/ilamy-calendar.git"
	},
	"type": "module",
	"exports": {
		"./helpers": {
			"types": "./dist/helpers.d.ts",
			"import": "./dist/helpers.js"
		},
		"./ical-format": {
			"types": "./dist/ical-format.d.ts",
			"import": "./dist/ical-format.js"
		},
		"./temporal": {
			"types": "./dist/temporal.d.ts",
			"import": "./dist/temporal.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "CI=true NODE_ENV=production bunx bunup",
		"type-check": "bun check --no-script",
		"test": "bun test",
		"lint": "bunx biome lint . --diagnostic-level=error",
		"check": "bunx biome check . --diagnostic-level=error",
		"ci": "bun run check && bun run type-check && bun run build"
	},
	"dependencies": {
		"temporal-polyfill": "1.0.8"
	}
}
