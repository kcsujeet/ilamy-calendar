{
	"name": "@ilamy/calendar",
	"version": "4.0.0",
	"description": "A framework-agnostic headless calendar engine with Temporal timezones, layered CSS tokens, and first-class React, Vue, Svelte, Solid, and Angular adapters.",
	"author": "Sujeet Kc",
	"license": "MIT",
	"homepage": "https://ilamy.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kcsujeet/ilamy-calendar.git"
	},
	"bugs": {
		"url": "https://github.com/kcsujeet/ilamy-calendar/issues"
	},
	"keywords": [
		"react",
		"vue",
		"svelte",
		"solid",
		"angular",
		"calendar",
		"headless",
		"temporal",
		"typescript",
		"tailwind",
		"shadcn",
		"events",
		"scheduling",
		"drag-and-drop",
		"recurring-events"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/adapters/react.d.ts",
			"import": "./dist/adapters/react.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./plugins/recurrence": {
			"types": "./dist/plugins/recurrence.d.ts",
			"import": "./dist/plugins/recurrence.js"
		},
		"./plugins/agenda": {
			"types": "./dist/plugins/agenda.d.ts",
			"import": "./dist/plugins/agenda.js"
		},
		"./plugins/drag-to-create": {
			"types": "./dist/plugins/drag-to-create.d.ts",
			"import": "./dist/plugins/drag-to-create.js"
		},
		"./plugins/year": {
			"types": "./dist/plugins/year.d.ts",
			"import": "./dist/plugins/year.js"
		},
		"./plugins/ical": {
			"types": "./dist/plugins/ical.d.ts",
			"import": "./dist/plugins/ical.js"
		},
		"./vue": {
			"types": "./dist/adapters/vue.d.ts",
			"import": "./dist/adapters/vue.js"
		},
		"./svelte": {
			"types": "./dist/adapters/svelte.d.ts",
			"import": "./dist/adapters/svelte.js"
		},
		"./solid": {
			"types": "./dist/adapters/solid.d.ts",
			"import": "./dist/adapters/solid.js"
		},
		"./angular": {
			"types": "./dist/adapters/angular.d.ts",
			"import": "./dist/adapters/angular.js"
		},
		"./styles.css": "./dist/styles.css",
		"./styles/base.css": "./dist/styles/base.css",
		"./styles/theme.css": "./dist/styles/theme.css"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "CI=true NODE_ENV=production bunx bunup && bun scripts/build-styles.ts",
		"test": "bun --conditions=browser test",
		"test:coverage": "bun --conditions=browser test --coverage",
		"type-check": "bun check --no-script",
		"check:dist-types": "bun check --no-script -p tsconfig.dist.json",
		"lint": "bunx biome lint . --diagnostic-level=error",
		"check": "bunx biome check . --diagnostic-level=error",
		"check:fix": "bunx biome check --write .",
		"ci": "bun run check && bun run type-check && bun run test && bun run build",
		"prepack": "bun scripts/prepack.ts",
		"postpack": "bun scripts/postpack.ts"
	},
	"peerDependencies": {
		"@angular/core": "^22.0.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"rrule": "^2.8.1",
		"solid-js": "^2.0.0",
		"svelte": "^5.0.0",
		"tailwindcss": "^4.2.2",
		"vue": "^3.5.0"
	},
	"peerDependenciesMeta": {
		"@angular/core": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"rrule": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"tailwindcss": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"dependencies": {
		"preact": "11.2.0",
		"temporal-polyfill": "1.0.8"
	},
	"devDependencies": {
		"@angular/core": "22.3.0",
		"rrule": "2.8.1",
		"rxjs": "7.8.2",
		"solid-js": "2.0.3",
		"svelte": "5.59.1",
		"vue": "3.5.45"
	},
	"publishConfig": {
		"access": "public"
	}
}
