{
	"name": "@ilamy/dom",
	"version": "4.0.0",
	"private": true,
	"description": "Zero-React full-parity DOM calendar renderer built on @ilamy/core, shared by Vue, Svelte, Solid, and Angular adapters.",
	"author": "Sujeet Kc",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kcsujeet/ilamy-calendar.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "CI=true NODE_ENV=production bunx bunup",
		"test": "bun test",
		"type-check": "bun check --no-script",
		"lint": "bunx biome lint . --diagnostic-level=error",
		"check": "bunx biome check . --diagnostic-level=error",
		"ci": "bun run check && bun run type-check && bun run test && bun run build"
	},
	"dependencies": {
		"@ilamy/core": "workspace:*",
		"@ilamy/utils": "workspace:*",
		"rrule": "^2.8.1"
	}
}
