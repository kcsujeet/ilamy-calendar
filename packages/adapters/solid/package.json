{
	"name": "@ilamy/adapter-solid",
	"version": "4.0.0",
	"private": true,
	"description": "Solid 2.0 signal-backed reactive adapter and mount helper for @ilamy/calendar.",
	"author": "Sujeet Kc",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kcsujeet/ilamy-calendar.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "CI=true NODE_ENV=production bunx bunup",
